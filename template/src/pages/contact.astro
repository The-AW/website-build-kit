---
export const prerender = true;
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { business, addressOneLine } from '../data/business';

/** Static contact details are safe on a static-only build; forms are opt-in. */
---

<Base
  title={`Contact - ${business.name}`}
  description={`Get in touch with ${business.name}. Call ${business.phone.display} or email us.`}
  canonical="/contact/"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Contact', href: '/contact/' }]}
>
  <PageHero
    title="Contact"
    lede={`For enquiries, call or email ${business.name}.`}
    breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Contact', href: '/contact/' }]}
  />

  <section class="section--tight">
    <div class="container container--text">
      <h2>Details</h2>
      <ul role="list" class="contact__details">
        <li><a href={business.phone.href}>{business.phone.display}</a></li>
        <li><a href={business.email.href}>{business.email.display}</a></li>
        <li>{addressOneLine}</li>
        <li>{business.hours.display}</li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .contact__details {
    display: grid;
    gap: var(--space-2xs);
    margin-block-start: var(--space-m);
    padding: 0;
    color: var(--text-muted);
  }
</style>
