---
export const prerender = true;
/**
 * File-backed root routes for legal pages and blog posts.
 *
 * Legal pages preserve their existing /privacy/, /terms/, and similar URLs;
 * published blog records use the root-level /<slug>/ URLs already emitted by
 * the RSS feed. Drafts are excluded by getPosts(). Both collections share this
 * route, so collisions with static pages or each other fail the build.
 */
import { render } from 'astro:content';

import PageHero from '../components/PageHero.astro';
import Base from '../layouts/Base.astro';
import { business } from '../data/business';
import { getLegalPages, formatLegalDate, type LegalPage } from '../lib/legal';
import { getPosts, formatDate, readingMinutes, type Post } from '../lib/posts';
import { assertUniqueRootRouteClaims } from '../lib/content-routes';

export async function getStaticPaths() {
  const reserved = new Set(
    Object.keys(import.meta.glob('./**/*.{astro,md,ts,js}'))
      .map((file) => file.replace(/^\.\//, '').split('/')[0])
      .map((segment) => segment.replace(/\.(astro|md|ts|js)$/, ''))
      .filter((segment) => !segment.startsWith('[')),
  );
  const legalPages = await getLegalPages();
  const posts = await getPosts();
  assertUniqueRootRouteClaims(reserved, [
    ...legalPages.map((page) => ({ id: page.id, source: `src/content/legal/${page.id}.md` })),
    ...posts.map((post) => ({ id: post.id, source: `src/content/blog/${post.id}.md` })),
  ]);

  return [
    ...legalPages.map((page) => ({ params: { slug: page.id }, props: { page } })),
    ...posts.map((post) => ({ params: { slug: post.id }, props: { post } })),
  ];
}

interface Props {
  page?: LegalPage;
  post?: Post;
}

const { page, post } = Astro.props;
if (Boolean(page) === Boolean(post)) throw new Error('Root collection route requires exactly one legal page or blog post.');
const legalRender = page ? await render(page) : null;
const postRender = post ? await render(post) : null;
const LegalContent = legalRender?.Content;
const PostContent = postRender?.Content;
const postBody = post?.body ?? '';
const legalBreadcrumbs = page
  ? [{ name: 'Home', href: '/' }, { name: page.data.title, href: `/${page.id}/` }]
  : [];
const postBreadcrumbs = post
  ? [{ name: 'Home', href: '/' }, { name: post.data.title, href: `/${post.id}/` }]
  : [];
const articleTitle = post?.data.seoTitle ?? '';
---

{page && LegalContent && (
  <Base
    title={`${page.data.title} - ${business.name}`}
    description={page.data.description}
    canonical={`/${page.id}/`}
    noindex={page.data.noindex}
    breadcrumbs={legalBreadcrumbs}
  >
    <PageHero title={page.data.title} breadcrumbs={legalBreadcrumbs} />

    <section class="section">
      <div class="container container--text prose">
        <p>
          <strong>Effective <time datetime={page.data.effective}>{formatLegalDate(page.data.effective)}</time></strong>
          {page.data.updated && (
            <>
              {' · '}
              <span>Last updated <time datetime={page.data.updated}>{formatLegalDate(page.data.updated)}</time></span>
            </>
          )}
        </p>
        <LegalContent />
      </div>
    </section>
  </Base>
)}

{post && PostContent && (
  <Base
    title={articleTitle}
    description={post.data.description}
    canonical={`/${post.id}/`}
    image={post.data.image}
    imageAlt={post.data.imageAlt}
    type="article"
    publishedAt={post.data.publishedAt}
    updatedAt={post.data.updatedAt}
    schemaType="article"
    breadcrumbs={postBreadcrumbs}
    article={{
      headline: post.data.title,
      description: post.data.description,
      image: post.data.image,
      imageAlt: post.data.imageAlt,
      publishedAt: post.data.publishedAt,
      updatedAt: post.data.updatedAt,
      url: `/${post.id}/`,
      author: post.data.author,
    }}
  >
    <PageHero title={post.data.title} lede={post.data.description} breadcrumbs={postBreadcrumbs}>
      <div class="article-meta">
        {post.data.author && (
          <span>
            By {post.data.author.url
              ? <a href={post.data.author.url}>{post.data.author.name}</a>
              : post.data.author.name}
            {' · '}
          </span>
        )}
        <span>Published <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time></span>
        {post.data.updatedAt && post.data.updatedAt.getTime() !== post.data.publishedAt.getTime() && (
          <span> · Updated <time datetime={post.data.updatedAt.toISOString()}>{formatDate(post.data.updatedAt)}</time></span>
        )}
        <span> · {readingMinutes(postBody)} min read</span>
      </div>
      <div class="article-categories">
        {post.data.categories.map((category) => <span>{category}</span>)}
      </div>
    </PageHero>

    <section class="section">
      <div class="container container--text prose">
        <PostContent />
      </div>
    </section>
  </Base>
)}
