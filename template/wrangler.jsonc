{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Neutral defaults only. scripts/lib/aw-migration.mjs generates a distinct
  // .aw/wrangler-staging.jsonc or .aw/wrangler-production.jsonc from
  // aw-migration.json before every build/deploy. Never deploy this file directly.
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
